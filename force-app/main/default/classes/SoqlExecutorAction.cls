/**
 * Invocable Apex action used by the Negoptim SOQL Assistant / SOQL Builder agent.
 * Validates SOQL (allowed objects, SELECT-only), then executes. Never throws past this action.
 */
public with sharing class SoqlExecutorAction {
    private static final Pattern FROM_PATTERN = Pattern.compile('(?i)\\bFROM\\s+([a-zA-Z0-9_]+)');
    private static final Pattern LIMIT_PATTERN = Pattern.compile('(?i)\\bLIMIT\\s+(\\d+)');
    private static final Pattern DML_PATTERN = Pattern.compile(
        '(?i)\\b(INSERT|UPDATE|DELETE|UPSERT|MERGE)\\b'
    );

    public class Request {
        @InvocableVariable(required=true label='SOQL Query' description='SELECT query generated by the agent')
        public String soqlQuery;
        @InvocableVariable(
            label='Row Limit'
            description='Optional max rows (1–1000). Overrides or clamps LIMIT in the SOQL string.'
        )
        public Integer rowLimit;
    }

    public class Response {
        @InvocableVariable(label='Result JSON' description='JSON envelope with success, soql, columns/rows or error')
        public String resultJson;
    }

    public class ColumnInfo {
        public String label;
        public String fieldName;
        public String type;
    }

    public class ResultEnvelope {
        public Boolean success;
        public String soql;
        public String error;
        public List<ColumnInfo> columns;
        public List<Map<String, Object>> rows;
    }

    @InvocableMethod(
        label='Execute Validated SOQL'
        description='Validates and executes a SOQL SELECT query against whitelisted objects only, returns JSON with columns and rows.'
    )
    public static List<Response> execute(List<Request> requests) {
        List<Response> responses = new List<Response>();
        if (requests == null || requests.isEmpty()) {
            Response empty = new Response();
            empty.resultJson = toErrorJson(null, 'No SOQL query was provided.');
            responses.add(empty);
            return responses;
        }

        for (Request req : requests) {
            Response res = new Response();
            res.resultJson = processOne(
                req != null ? req.soqlQuery : null,
                req != null ? req.rowLimit : null
            );
            responses.add(res);
        }
        return responses;
    }

    @TestVisible
    private static String processOne(String soqlQuery, Integer rowLimit) {
        String attempted = soqlQuery;
        try {
            if (String.isBlank(soqlQuery)) {
                return toErrorJson(soqlQuery, 'SOQL query is required.');
            }

            String trimmed = soqlQuery.trim();
            attempted = trimmed;

            if (!trimmed.toUpperCase().startsWith('SELECT')) {
                return toErrorJson(trimmed, 'Only SELECT queries are allowed.');
            }

            if (DML_PATTERN.matcher(trimmed).find()) {
                return toErrorJson(
                    trimmed,
                    'Query rejected: INSERT, UPDATE, DELETE, UPSERT, and MERGE are not allowed.'
                );
            }

            String fromObject = extractFromObject(trimmed);
            if (String.isBlank(fromObject)) {
                return toErrorJson(trimmed, 'Could not determine the FROM object in the query.');
            }

            if (SoqlSchemaCatalog.isExcludedObject(fromObject)) {
                return toErrorJson(
                    trimmed,
                    'Object "' +
                        fromObject +
                        '" is excluded from SOQL Builder. Try a smaller object or refine filters.'
                );
            }

            if (!SoqlSchemaCatalog.isObjectAllowed(fromObject)) {
                return toErrorJson(
                    trimmed,
                    'Object "' +
                        fromObject +
                        '" is not queryable or not accessible. Call GetSchema and pick an allowed object.'
                );
            }

            String fieldError = validateSelectedFields(trimmed, fromObject);
            if (fieldError != null) {
                return toErrorJson(trimmed, fieldError);
            }

            String finalSoql = enforceLimit(trimmed, rowLimit);
            attempted = finalSoql;

            List<SObject> records = runQuery(finalSoql);
            ResultEnvelope envelope = new ResultEnvelope();
            envelope.success = true;
            envelope.soql = finalSoql;
            envelope.columns = buildColumns(records, fromObject);
            envelope.rows = buildRows(records);
            return JSON.serialize(envelope);
        } catch (QueryException qe) {
            return toErrorJson(
                attempted,
                'Query failed: ' +
                    qe.getMessage() +
                    '. Try refining filters or using a smaller LIMIT.'
            );
        } catch (Exception ex) {
            return toErrorJson(
                attempted,
                'Unable to execute query: ' +
                    ex.getMessage() +
                    '. Try refining filters or using a smaller LIMIT.'
            );
        }
    }

    @TestVisible
    private static String extractFromObject(String soql) {
        Matcher m = FROM_PATTERN.matcher(soql);
        if (m.find()) {
            return m.group(1);
        }
        return null;
    }

    /**
     * Field checks use SoqlSchemaCatalog (CMDT field lists when present; otherwise allow all accessible fields).
     */
    @TestVisible
    private static String validateSelectedFields(String soql, String fromObject) {
        Integer fromIdx = soql.toUpperCase().indexOf(' FROM ');
        if (fromIdx < 0) {
            return null;
        }
        String selectClause = soql.substring(6, fromIdx).trim();
        if (selectClause == '*') {
            return 'SELECT * is not allowed. List field API names explicitly.';
        }

        for (String token : selectClause.split(',')) {
            String field = token.trim();
            if (String.isBlank(field)) {
                continue;
            }
            String upper = field.toUpperCase();
            Integer asIdx = upper.indexOf(' AS ');
            if (asIdx > 0) {
                field = field.substring(0, asIdx).trim();
            } else if (field.contains(' ')) {
                field = field.substring(0, field.indexOf(' ')).trim();
            }
            if (field.contains('.')) {
                return 'Relationship / joined fields are not allowed ("' + field + '"). Query one object only.';
            }
            if (!SoqlSchemaCatalog.isFieldAllowed(fromObject, field)) {
                return 'Field "' + field + '" is not in the allowed field list for ' + fromObject + '.';
            }
        }
        return null;
    }

    @TestVisible
    private static String enforceLimit(String soql) {
        return enforceLimit(soql, null);
    }

    @TestVisible
    private static String enforceLimit(String soql, Integer rowLimit) {
        Integer maxAllowed = SoqlSchemaCatalog.getMaxLimit();
        Integer defaultLimit = SoqlSchemaCatalog.getDefaultLimit();
        Integer target = defaultLimit;
        if (rowLimit != null && rowLimit > 0) {
            target = Math.min(rowLimit, maxAllowed);
        }

        Matcher m = LIMIT_PATTERN.matcher(soql);
        if (m.find()) {
            Integer existing = Integer.valueOf(m.group(1));
            Integer clamped = Math.min(existing, maxAllowed);
            if (rowLimit != null && rowLimit > 0) {
                clamped = Math.min(clamped, target);
            }
            return m.replaceFirst('LIMIT ' + String.valueOf(clamped));
        }
        return soql + ' LIMIT ' + String.valueOf(target);
    }

    @TestVisible
    private static List<SObject> runQuery(String soql) {
        try {
            return Database.query(soql, AccessLevel.USER_MODE);
        } catch (QueryException qe) {
            // Malformed SOQL / object missing — bubble to processOne for JSON error envelope
            throw qe;
        } catch (Exception ex) {
            // Fallback when USER_MODE path is unavailable: query then strip inaccessible fields
            List<SObject> raw = Database.query(soql);
            SObjectAccessDecision decision = Security.stripInaccessible(AccessType.READABLE, raw);
            return decision.getRecords();
        }
    }

    @TestVisible
    private static List<ColumnInfo> buildColumns(List<SObject> records, String objectApiName) {
        List<ColumnInfo> columns = new List<ColumnInfo>();
        if (records == null || records.isEmpty()) {
            return columns;
        }

        Schema.SObjectType sType = records[0].getSObjectType();
        Map<String, Schema.SObjectField> fieldMap = sType.getDescribe().fields.getMap();
        Map<String, Object> populated = records[0].getPopulatedFieldsAsMap();

        for (String fieldName : populated.keySet()) {
            if (fieldName == null) {
                continue;
            }
            // Skip nested relationship SObject maps for datatable simplicity
            Object val = populated.get(fieldName);
            if (val instanceof SObject) {
                continue;
            }

            ColumnInfo col = new ColumnInfo();
            col.fieldName = fieldName;

            Schema.SObjectField sof = fieldMap.get(fieldName);
            if (sof != null) {
                Schema.DescribeFieldResult dfr = sof.getDescribe();
                col.label = dfr.getLabel();
                col.type = mapColumnType(dfr.getType());
            } else {
                col.label = fieldName;
                col.type = 'text';
            }
            columns.add(col);
        }
        return columns;
    }

    @TestVisible
    private static String mapColumnType(Schema.DisplayType dt) {
        if (dt == null) {
            return 'text';
        }
        if (dt == Schema.DisplayType.CURRENCY) {
            return 'currency';
        }
        if (dt == Schema.DisplayType.DATE) {
            return 'date-local';
        }
        if (dt == Schema.DisplayType.DATETIME) {
            return 'date';
        }
        if (
            dt == Schema.DisplayType.DOUBLE ||
            dt == Schema.DisplayType.INTEGER ||
            dt == Schema.DisplayType.LONG ||
            dt == Schema.DisplayType.PERCENT
        ) {
            return 'number';
        }
        if (dt == Schema.DisplayType.BOOLEAN) {
            return 'boolean';
        }
        if (dt == Schema.DisplayType.EMAIL) {
            return 'email';
        }
        if (dt == Schema.DisplayType.PHONE) {
            return 'phone';
        }
        if (dt == Schema.DisplayType.URL) {
            return 'url';
        }
        return 'text';
    }

    @TestVisible
    private static List<Map<String, Object>> buildRows(List<SObject> records) {
        List<Map<String, Object>> rows = new List<Map<String, Object>>();
        if (records == null) {
            return rows;
        }
        Integer idx = 0;
        for (SObject rec : records) {
            Map<String, Object> row = new Map<String, Object>();
            Map<String, Object> populated = rec.getPopulatedFieldsAsMap();
            for (String fieldName : populated.keySet()) {
                Object val = populated.get(fieldName);
                if (val instanceof SObject) {
                    continue;
                }
                if (val instanceof Datetime) {
                    row.put(fieldName, ((Datetime) val).formatGmt('yyyy-MM-dd\'T\'HH:mm:ss\'Z\''));
                } else if (val instanceof Date) {
                    Date d = (Date) val;
                    row.put(
                        fieldName,
                        String.valueOf(d.year()) +
                            '-' +
                            String.valueOf(d.month()).leftPad(2, '0') +
                            '-' +
                            String.valueOf(d.day()).leftPad(2, '0')
                    );
                } else {
                    row.put(fieldName, val);
                }
            }
            // lightning-datatable needs a unique key field; ensure Id or synthetic key
            if (!row.containsKey('Id')) {
                row.put('rowKey', 'r' + String.valueOf(idx));
            }
            rows.add(row);
            idx++;
        }
        return rows;
    }

    @TestVisible
    private static String toErrorJson(String soql, String message) {
        ResultEnvelope envelope = new ResultEnvelope();
        envelope.success = false;
        envelope.soql = soql;
        envelope.error = message;
        envelope.columns = new List<ColumnInfo>();
        envelope.rows = new List<Map<String, Object>>();
        return JSON.serialize(envelope);
    }
}